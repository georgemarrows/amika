{
  "name": "amika",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:client": "vite --config vite.config.ts",
    "dev:server": "node --import tsx --watch server/src/index.ts",
    "db:migrate": "node --import tsx scripts/db-migrate.ts",
    "import:kanji-damage": "node --import tsx scripts/import-kanji-damage.ts",
    "repair:kanji-damage-import": "node --import tsx scripts/repair-kanji-damage-import.ts",
    "build": "bun run build:client && bun run build:server",
    "build:client": "vite build --config vite.config.ts",
    "build:server": "rm -rf dist/server && tsc -p server/tsconfig.json",
    "start": "node dist/server/server/src/index.js",
    "test": "bun run test:client && bun run test:server && bun run test:db",
    "test:client": "bun test ./client/src/**/*.test.ts",
    "test:client:coverage": "bun test --coverage ./client/src/**/*.test.ts",
    "test:server": "node --import tsx --test ./server/src/app.test.ts",
    "test:server-importer:coverage": "node --import tsx --test --experimental-test-coverage ./server/src/app.test.ts ./server/src/db/*.test.ts ./scripts/*.test.ts",
    "test:db": "node --import tsx --test ./server/src/db/*.test.ts ./scripts/*.test.ts",
    "test:soak": "node --import tsx --test ./soaktest/*.test.ts",
    "typecheck": "tsc -p client/tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "jszip": "^3.10.1",
    "solid-js": "^1.9.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "bun-types": "^1.3.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vite-plugin-solid": "^2.11.10"
  }
}
