{
  "name": "amika",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:client": "vite --config vite.config.ts",
    "dev:server": "bun --watch server/src/index.ts",
    "build": "bun run build:client && bun run build:server",
    "build:client": "vite build --config vite.config.ts",
    "build:server": "rm -rf dist/server && tsc -p server/tsconfig.json",
    "start": "bun dist/server/server/src/index.js",
    "test": "bun test ./client/src/home-view-model.test.ts ./server/src/app.test.ts",
    "test:client": "bun test ./client/src/home-view-model.test.ts",
    "test:server": "bun test ./server/src/app.test.ts",
    "typecheck": "tsc -p client/tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "solid-js": "^1.9.9"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "bun-types": "^1.3.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vite-plugin-solid": "^2.11.10"
  }
}
